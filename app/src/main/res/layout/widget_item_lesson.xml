<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="1.5dp">

    <!-- Lesson Number -->
    <TextView
        android:id="@+id/item_lsn_num"
        android:layout_width="16dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="#888888"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Lesson Time -->
    <TextView
        android:id="@+id/item_lsn_time"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="8:15"
        android:textColor="#008000"
        android:textSize="8sp" />

    <!-- Subject and Teacher/Class -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_lsn_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Предмет"
            android:textColor="#222288"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_lsn_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Преподаватель"
            android:textColor="#556677"
            android:textSize="7.5sp" />
    </LinearLayout>

    <!-- Room -->
    <TextView
        android:id="@+id/item_lsn_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:background="@drawable/widget_badge_bg"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:text="211"
        android:textColor="#111111"
        android:textSize="8.5sp"
        android:textStyle="bold" />

</LinearLayout>
