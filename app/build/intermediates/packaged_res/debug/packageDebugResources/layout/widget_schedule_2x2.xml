<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingTop="5dp"
    android:paddingRight="5dp"
    android:paddingBottom="5dp">

    <!-- Top Row: Target & Live Bell Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_btn_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/widget_icon_target"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_group" />

            <TextView
                android:id="@+id/widget_text_target"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="10-1"
                android:textColor="#0F172A"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_text_bell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:background="@null"
            android:maxLines="1"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:text="45 мин"
            android:textColor="#059669"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navigation Day Bar with < Date > & Copy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@null"
            android:padding="3dp"
            android:src="@drawable/ic_widget_arrow_back"
            android:contentDescription="Предыдущий день" />

        <TextView
            android:id="@+id/widget_text_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:gravity="start|center_vertical"
            android:text="Чт, 12 нояб."
            android:textColor="#0F172A"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_btn_copy"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@null"
            android:padding="3dp"
            android:src="@drawable/ic_widget_copy"
            android:contentDescription="Скопировать расписание" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@null"
            android:padding="3dp"
            android:src="@drawable/ic_widget_arrow_forward"
            android:contentDescription="Следующий день" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:background="#E2E8F0"
        android:contentDescription="@null" />

    <!-- Content: List of Lessons -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_lesson_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="В этот день уроков нет"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
