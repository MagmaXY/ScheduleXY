<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="1dp"
        android:paddingTop="2dp"
        android:paddingRight="1dp"
        android:paddingBottom="2dp">

        <!-- Lesson Number -->
        <TextView
            android:id="@+id/item_lsn_num"
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Lesson Time (stacked start and end) -->
        <TextView
            android:id="@+id/item_lsn_time"
            android:layout_width="23dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:text="8:15\n9:00"
            android:textColor="#008000"
            android:textSize="7.5sp"
            android:textStyle="bold" />

        <!-- Content Column: Subgroup 1 & Optional Subgroup 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Subgroup 1 -->
            <LinearLayout
                android:id="@+id/item_sg1_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Line 1: Subject + Room (Room on the right, never truncated) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/item_lsn_subject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Предмет"
                        android:textColor="#222288"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/item_lsn_room"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:text="(211)"
                        android:textColor="#000000"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Line 2: Teacher / Class & Group -->
                <TextView
                    android:id="@+id/item_lsn_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Преподаватель - 1 группа"
                    android:textColor="#226666"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Subgroup 2 -->
            <LinearLayout
                android:id="@+id/item_sg2_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Line 1: Subject 2 + Room 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/item_lsn_subject_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#222288"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/item_lsn_room_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:textColor="#000000"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Line 2: Teacher 2 & Group 2 -->
                <TextView
                    android:id="@+id/item_lsn_sub_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#226666"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Line 3: Homework -->
            <TextView
                android:id="@+id/item_lsn_homework"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="#555555"
                android:textSize="7.5sp"
                android:visibility="gone" />

            <!-- Line 4: Note -->
            <TextView
                android:id="@+id/item_lsn_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="#555555"
                android:textSize="7.5sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Before / After school note container -->
    <LinearLayout
        android:id="@+id/item_slot_note_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingTop="3dp"
        android:paddingRight="4dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/item_slot_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="До уроков"
            android:textColor="#222288"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_slot_note_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#555555"
            android:textSize="7.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/item_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E2E8F0"
        android:contentDescription="@null" />

</LinearLayout>
